# ============================================================
# DeepSeek 2API 配置示例 —— 复制为 .env 后按需填写
# 说明：所有 DeepSeek 认证项都可以留空！服务仍会正常启动，
#      之后可在管理面板 (/admin) 添加 token / 账号，立即生效（热加载）。
# ============================================================

# ---- DeepSeek 认证（可全部留空，后期通过 /admin 添加）----
# 单个 token
DS_TOKEN=
# 多个 token，英文逗号分隔：token1,token2,token3
DS_TOKENS=
# 账号自动登录：email1:pass1,email2:pass2
DS_ACCOUNTS=
# 可选：将已有 token 关联到账号（用于自动刷新）：email:password:token前12位
# DS_ACCOUNTS_EXTENDED=

# ---- 服务端口 ----
PORT=3000

# ---- 客户端 API Key 鉴权（可选，留空则 /v1 与 /api/v0 不鉴权）----
# 支持多个，英文逗号分隔；也可在 /admin 面板增删（热加载）
API_KEYS=
# 兼容旧的单值写法（会与 API_KEYS 合并）
API_KEY=

# ---- 管理面板独立密码（与 API Key 相互独立）----
# 留空则面板无需登录；可在 /admin 面板设置 / 修改（热加载）
PANEL_PASSWORD=

# ---- 其他可选 ----
# 思考内容合并进 content 的 <think> 标签（默认 false：走独立 reasoning_content 字段）
# MERGE_THINKING=true
# 出口代理
# HTTPS_PROXY=
# 日志目录（Docker 部署建议 /app/logs；compose / Dockerfile 已默认设置）
# LOG_DIR=

# ---- 会话自动删除模式 ----
# none   — 保持会话（默认），不自动删除 DeepSeek 端会话
# single — 每次对话完成后自动删除当前会话
# all    — 每次对话完成后自动删除该账号的所有会话
AUTO_DELETE=none

# ---- 登录代理配置（可选，也可通过管理面板在线配置）----
# 仅用于添加账号时登录（绕过 WAF），不影响 API 转发。
# 优先级：携趣短效代理 > 手动代理 > 直连
# 携趣短效代理在每一次登录账号时重新从 API 拉取新的代理用以登陆。
# 推荐通过管理面板 (/admin) 的「登录代理」卡片配置，支持在线检测和热加载。
# MANUAL_LOGIN_PROXY=ip:port 或 user:pass@ip:port
# XIEQU_API_URL=http://api.xiequ.cn/VAL/getip?...
